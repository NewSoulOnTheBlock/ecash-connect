{
  "name": "@ecash-connect/core",
  "version": "0.1.0",
  "description": "Protocol, provider discovery, drivechain and replay-safety helpers for eCash (ECX) dapps and wallets. Derived from @sats-connect/core.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target browser --format esm --packages external && tsc -p . --emitDeclarationOnly --outDir dist"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "valibot": "1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NewSoulOnTheBlock/ecash-connect.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/NewSoulOnTheBlock/ecash-connect/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/NewSoulOnTheBlock/ecash-connect/issues"
  },
  "keywords": [
    "ecash",
    "ecx",
    "bitcoin",
    "drivechain",
    "bip300",
    "wallet",
    "dapp",
    "psbt",
    "bip322"
  ],
  "author": "eCash Cat contributors",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
