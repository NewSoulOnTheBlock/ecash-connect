{
  "manifest_version": 3,
  "name": "eCash Cat Wallet",
  "version": "0.1.0",
  "description": "An eCash (ECX) wallet for dapps: eCash Connect, BIP322 signing, PSBTs, a Bitcoin replay guard and drivechain deposits.",
  "icons": { "16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png" },
  "action": { "default_popup": "popup.html", "default_title": "eCash Cat Wallet", "default_icon": "icon.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inpage.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://mempool.space/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "minimum_chrome_version": "111"
}
